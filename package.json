{
  "name": "dsh-model-picker-augmented",
  "version": "1.1.1",
  "description": "Searchable, curated composer model picker for DeepSeek Harness: live model search, a Model Picker Augmented settings page to show/hide and pin models, and a Refresh providers button that syncs the running harness with settings.yaml (no restart) and auto-discovers newly declared provider models from their endpoints.",
  "license": "MIT",
  "author": {
    "name": "Manolo Remiddi"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "model-picker",
    "models",
    "ui"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  }
}
